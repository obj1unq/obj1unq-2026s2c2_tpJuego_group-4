import naveJugador.*
import navesEnemigas.*
import wollok.game.*

object config {

    method configureGame() {

        game.title("Wallaga") // Wollok + Galaga ;) 
        game.cellSize(100)
	    game.height(10)
	    game.width(10)
	    game.boardGround("fondo.png")

    }

    method controles(){

        keyboard.w().onPressDo({ jugador.moverArriba() })
        keyboard.s().onPressDo({ jugador.moverAbajo() })
        keyboard.a().onPressDo({ jugador.moverIzquierda() })
        keyboard.d().onPressDo({ jugador.moverDerecha() })
        keyboard.space().onPressDo({ jugador.disparar() })

    }

}



program juego {

    config.configureGame()
    config.controles()

    game.addVisual(jugador)
 // game.addVisual("score.png") hay q pensar como mostrar los puntos sin tener que agregar 20.000 imagenes
    
    const tanque1 = new Tanque(position = game.at(5, 8))
    game.onTick(10000, "generarTanque" + tanque1.identity(), {tanque1.aparecer()})

    game.start()

}