// la mayoría de las cosas de este archivo se movieron a mecanicas.wlk por el tema del reinicio y demás
// todos los boardGround ya no están, no me deja cambiar entre uno y otro así que los tuve que tratar como objetos :P
object config {
    method configureGame() {
        game.title("Wallaga") // Wollok + Galaga ;) 
        game.cellSize(100)
	    game.height(10)
	    game.width(10)
    }
}



program juego {
    config.configureGame()
    mecanicas.iniciarMenu()
    game.start()
}