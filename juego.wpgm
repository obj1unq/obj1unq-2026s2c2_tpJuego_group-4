import mecanicas.*
import naveJugador.*
import navesEnemigas.*
import wollok.game.*




// la mayoría de las cosas de este archivo se movieron a mecanicas.wlk por el tema del reinicio y demás
object config {
    method configureGame() {
        game.title("Wallaga") // Wollok + Galaga ;) 
        game.cellSize(100)
	    game.height(10)
	    game.width(10)
	    game.boardGround("fondo.png")
    }
}



program juego {
    config.configureGame()
    const tanque1 = new Tanque(position = game.at(0, 5), posicionInicial = game.at(5, 5))
    const tanque2 = new Tanque(position = game.at(9, 6), posicionInicial = game.at(5, 6))
    mecanicas.iniciarPartida([tanque1, tanque2])

    game.start()
}