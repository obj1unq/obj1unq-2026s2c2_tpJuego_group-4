import wollok.game.*
import direcciones.*
import personaje.*
import puerta.*
import cosas.*




object config {
	method configurarEscenario() {
		game.title("Aca debería ir el nombre del juego...")
		game.height(10)
		game.width(10)
		game.boardGround("fondoGris1.jpg")
		//game.boardGround("fondoGris2.jpg")
	}
}

program Juego {
	config.configurarEscenario()

	game.addVisual(puerta)

	const coso1 = new CosaUObstaculo(position = game.at(6,7))
	game.addVisual(coso1)
	const coso2 = new CosaUObstaculo(position = game.at(4,9))
	game.addVisual(coso2)
	const coso3 = new CosaUObstaculo(position = game.at(6,7))
	game.addVisual(coso3)
	
	const cosas = [coso1, coso2, coso3]

	

	game.addVisual(personaje)     //ojo en dónde se pone, porque al mover al pj este puede quedar debajo de otras imagenes
	
	// TECLAS
	keyboard.w().onPressDo({personaje.mover(arriba)})
	keyboard.a().onPressDo({personaje.mover(izquierda)})
	keyboard.s().onPressDo({personaje.mover(abajo)})
	keyboard.d().onPressDo({personaje.mover(derecha)})
	keyboard.f().onPressDo({personaje.interactuarLinterna()})
	keyboard.e().onPressDo({personaje.buscarBarritaDentroDe(cosa)})
	game.start()
}
