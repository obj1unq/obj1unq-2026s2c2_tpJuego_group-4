import wollok.game.*
import luz.*
import personaje.*
import puerta.*
import monticulo.*
import pantallas.*




describe "Tests de cualquier cosa..." {
  method initialize() {
    personaje.position(puerta.position())
  }

  test "pasar de nivel con todas las cosas" {
    const cosa1 = new Monticulo(position = game.at(1, 1))
    const cosa2 = new Monticulo(position = game.at(2, 2))
    const cosa3 = new Monticulo(position = game.at(3, 3))
    const cosasDelNivel = [cosa1, cosa2, cosa3]
    
    cosasDelNivel.forEach({o => personaje.mochilaAdd(o)})
    //const mochilaCompleta = [cosa1, cosa2, cosa3]

    personaje.abrirPuerta()

    //assert.equals(game.at(0, 3), personaje.position())
    assert.that((game.getObjectsIn(game.at(0, 0))).contains(pantallaGE))
  }

  test "no abrir la puerta con solo dos cosas" {
    const cosa1 = new Monticulo(position = game.at(1, 1))
    const cosa2 = new Monticulo(position = game.at(2, 2))
    //const cosa3 = new Monticulo(position = game.at(3, 3))
    const cosasDelNivel = [cosa1, cosa2]
    cosasDelNivel.forEach({o => personaje.mochilaAdd(o)})
    //const mochilaIncompleta = [cosa1, cosa2]

    //assert.throwsExceptionWithMessage("No tenemos todas las cosas para abrir la puerta.", { => personaje.abrirPuerta() })
    assert.throwsException({personaje.abrirPuerta()})
    //assert.equals(puerta.position(), personaje.position())
  }

  test "detectar monticulo cercano en diagonal y junto al borde" {
    const monticulo = new Monticulo(position = game.at(0, 0))
    monticulosEnSala.registrar(monticulo)
    game.addVisual(monticulo)

    personaje.position(game.at(1, 1))
    assert.equals(true, personaje.hayMonticuloCerca())

    personaje.position(game.at(0, 1))
    assert.equals(true, personaje.hayMonticuloCerca())

    personaje.position(game.at(2, 2))
    assert.equals(false, personaje.hayMonticuloCerca())

    game.removeVisual(monticulo)
    monticulosEnSala.quitar(monticulo)
  }

  test "efecto parpadeo" {
    inicio.apagar()
    assert.equals("fondoOscuro.jpg", inicio.fondo())

    inicio.parpadear()
    assert.equals("fondoGris.jpg", inicio.fondo())

    inicio.parpadear()
    assert.equals("fondoOscuro.jpg", inicio.fondo())
  }
}
